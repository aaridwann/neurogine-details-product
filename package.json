{
  "name": "@Neurogine/detail-product",
  "version": "1.0.0",
  "description": "Modular detail screen feature for React Native",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && tsc",
    "watch": "tsc --watch",
    "prepublishOnly": "yarn build",
    "typescript": "tsc --noEmit",
    "lint": "ESLINT_USE_FLAT_CONFIG=true eslint . --no-cache",
    "lint:fix": "ESLINT_USE_FLAT_CONFIG=true eslint . --fix --no-cache",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@react-native/eslint-config": "^0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4",
    "@types/react": "^18.0.0",
    "@types/react-native": "^0.72.0",
    "@types/react-test-renderer": "^19",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-perfectionist": "^5.11.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "react-test-renderer": "^19.3.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.70.0"
  },
  "dependencies": {
    "@react-navigation/native": "^6.0.0",
    "@react-navigation/native-stack": "^6.0.0",
    "fast-memoize": "^2.5.2",
    "lodash": "^4.18.1"
  },
  "resolutions": {
    "@types/react": "^18.0.0"
  }
}