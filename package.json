{
  "name": "@Neurogine/detail-product",
  "version": "1.0.0",
  "description": "Modular detail screen feature for React Native",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && tsc",
    "watch": "tsc --watch",
    "prepublishOnly": "yarn build",
    "typescript": "tsc --noEmit",
    "lint": "ESLINT_USE_FLAT_CONFIG=true eslint . --no-cache",
    "lint:fix": "ESLINT_USE_FLAT_CONFIG=true eslint . --fix --no-cache",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:update": "jest -u",
    "test:coverage": "jest --coverage"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@babel/plugin-syntax-jsx": "^8.0.1",
    "@babel/preset-react": "^8.0.1",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@react-native/babel-preset": "^0.87.1",
    "@react-native/jest-preset": "^0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/lodash": "^4",
    "@types/node": "^26.5.1",
    "@types/react": "19.3.0",
    "@types/react-native": "^0.72.0",
    "@types/react-test-renderer": "^19",
    "babel-jest": "^30.5.1",
    "eslint": "^10.10.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "jiti": "^2.7.0",
    "metro-react-native-babel-preset": "^0.77.0",
    "prettier": "^3.9.6",
    "react-native": "^0.87.1",
    "react-test-renderer": "19.3.0",
    "test-renderer": "^1.2.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.70.0"
  },
  "dependencies": {
    "@Neurogine/core-network": "https://github.com/aaridwann/neurogine-core-network.git#master",
    "@Neurogine/root": "https://github.com/aaridwann/neurogine-root.git#master",
    "@Neurogine/ui-kit-button": "https://github.com/aaridwann/neurogine-ui-kit-button.git#master",
    "@Neurogine/ui-kit-general-text": "https://github.com/aaridwann/neurogine-ui-kit-general-text.git#master",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-vector-icons/ionicons": "^13.1.4",
    "@react-navigation/native": "^6.0.0",
    "@react-navigation/native-stack": "^6.0.0",
    "@reduxjs/toolkit": "^2.12.0",
    "fast-memoize": "^2.5.2",
    "lodash": "^4.18.1",
    "lottie-react-native": "^7.5.0",
    "lucide-react-native": "^1.45.0",
    "react-native-reanimated": "^4.6.0",
    "react-native-safe-area-context": "^5.9.1",
    "react-native-svg": "^15.15.5",
    "react-native-worklets": "^0.12.2",
    "react-redux": "^9.3.0"
  },
  "resolutions": {
    "@types/react": "^18.0.0"
  }
